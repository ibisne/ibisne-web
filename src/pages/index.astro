---
import Base from '../layouts/Base.astro';
---

<Base
  title="iBisne · Diseñamos tecnología para marcas selectas"
  description="Tech studio en Zapopan, Jalisco. Construimos hoy la tecnología que tu empresa necesitará mañana."
  page="home"
>
  <section class="hm" aria-labelledby="hm-h1">
    <!-- Viñetas: dan lectura al header y al titular sobre el mundo -->
    <div class="hm-vig" aria-hidden="true"></div>

    <!-- Ancla de la B: la dibuja el motor del mundo (WebGL); este div solo marca dónde y de qué alto -->
    <div class="hm-b" data-world-b aria-hidden="true"></div>

    <div class="hm-copy">
      <h1 id="hm-h1" class="hm-title" data-travel-ui>
        <span class="hm-title__thin">Diseñamos tecnología</span>
        <span class="hm-title__bold">para marcas selectas.</span>
      </h1>
      <p class="hm-sub" data-travel-ui>Construimos hoy la tecnología que tu empresa necesitará mañana.</p>
    </div>
  </section>
</Base>

<style>
  /* ---------- Móvil: apilado. Una pantalla menos barra inferior menos el enlace "Privacidad" ---------- */
  .hm {
    position: relative;
    min-height: calc(100svh - var(--tabbar-h) - 2rem);
    display: flex;
    flex-direction: column;
    padding: calc(var(--header-h) + 0.75rem) var(--gutter) 1.5rem;
  }

  .hm-vig {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to bottom, color-mix(in srgb, var(--ink) 70%, transparent), transparent 22%),
      linear-gradient(to top, color-mix(in srgb, var(--ink) 82%, transparent), transparent 55%);
  }

  .hm-b {
    position: relative;
    align-self: center;
    height: min(36svh, 300px);
    aspect-ratio: 0.95;
    margin-block: 0.5rem 1.5rem;
  }

  .hm-copy {
    position: relative;
    z-index: var(--z-ui);
    margin-top: auto;
    max-width: 62rem;
  }
  .hm-title {
    font-size: clamp(2.25rem, 10.5vw, 3.5rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .hm-title__thin,
  .hm-title__bold {
    display: block;
  }
  .hm-title__thin {
    font-weight: var(--w-thin);
  }
  .hm-title__bold {
    font-weight: var(--w-bold);
  }
  .hm-sub {
    margin-top: 1.25rem;
    max-width: 34ch;
    font-size: 1.125rem;
    font-weight: var(--w-regular);
    line-height: 1.4;
    color: var(--text-2);
    text-wrap: pretty;
  }

  /* ---------- Escritorio sin scroll (mismo umbral que global.css) ---------- */
  @media (min-width: 1024px) and (min-height: 700px) {
    .hm {
      height: 100%;
      min-height: 0;
      padding: 0;
    }
    .hm-b {
      position: absolute;
      left: 50%;
      top: 44%;
      translate: -50% -50%;
      height: min(40vh, 360px);
      margin: 0;
    }
    .hm-copy {
      position: absolute;
      left: 60px;
      right: 60px;
      bottom: 64px;
      max-width: none;
    }
    .hm-title {
      /* 6.2vw con tope de 88px; el limite por alto evita que choque con la B en ventanas bajas */
      font-size: clamp(48px, min(6.2vw, 9.5vh), 88px);
    }
    .hm-sub {
      margin-top: 1.5rem;
      max-width: none;
      font-size: 20px;
    }
  }
</style>
