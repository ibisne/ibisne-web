---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import bStill from '../assets/b/b-trim.png';
---

<Base
  title="iBisne · Diseñamos tecnología para marcas selectas"
  description="Tech studio en Mérida y Zapopan. Construimos hoy la tecnología que tu empresa necesitará mañana."
  page="home"
>
  <section class="hm" aria-labelledby="hm-h1">
    <!-- Viñetas: dan lectura al header y al titular sobre el mundo. data-travel-bg: entran con fundido al llegar (sin él aparecían de golpe al cambiar el DOM) -->
    <div class="hm-vig" data-travel-bg aria-hidden="true"></div>

    <!-- Ancla de la B: la dibuja el motor del mundo (WebGL); este div solo marca dónde y de qué alto -->
    <div class="hm-b" data-world-b aria-hidden="true">
      <!-- Solo con el mundo en respaldo estatico (movimiento reducido o sin WebGL): silueta con brillo, sin particulas -->
      <Image class="hm-b__still" src={bStill} alt="" width={420} loading="lazy" decoding="async" />
    </div>

    <div class="hm-copy">
      <h1 id="hm-h1" class="hm-title" data-travel-ui data-glitch-text>
        <span class="hm-title__thin">Diseñamos tecnología</span>
        <span class="hm-title__bold">para marcas selectas.</span>
      </h1>
      <p class="hm-sub" data-travel-ui data-glitch-text>Construimos hoy la tecnología que tu empresa necesitará mañana.</p>
      <!-- Qué hacemos: etiquetas, no botones (no enlazan). Entran con la cascada de la UI -->
      <ul class="hm-pills" aria-label="Qué hacemos" data-travel-ui>
        <li class="hm-pill">eCommerce</li>
        <li class="hm-pill">Software</li>
        <li class="hm-pill">Agentización</li>
        <li class="hm-pill">Apps</li>
      </ul>
    </div>
  </section>
</Base>

<style>
  /* ---------- Móvil: apilado. Una pantalla menos barra inferior ---------- */
  .hm {
    position: relative;
    /* Pantalla fija: la B (flexible) cede alto si hace falta. Mientras el banner de cookies esta
       abierto (--consent-h) se reserva su sitio para que no tape el subtitulo. */
    height: calc(100svh - var(--tabbar-h));
    min-height: 30rem;
    transition: padding-bottom 0.35s var(--ease-out); /* la B crece suave al cerrar el banner */
    display: flex;
    flex-direction: column;
    padding: calc(var(--header-h) + 0.75rem) var(--gutter) calc(1.5rem + max(0px, var(--consent-h, 0px) - 1rem));
    /* Tactil: arrastrar el dedo por la escena mueve la camara, la B y el glitch (engine.ts, eventos
       touch pasivos), como el mouse en escritorio. La pantalla es fija, asi que la escena no cede
       el gesto al navegador (sin scroll, sin tirar para recargar). Solo esta seccion: el header, la
       barra inferior y el banner de cookies quedan fuera y se tocan normal. */
    touch-action: none;
  }

  .hm-vig {
    position: absolute;
    /* baja hasta el borde de la pantalla (la capsula flotante deja ver lo que hay debajo: sin corte en seco) */
    inset: 0 0 calc(var(--tabbar-h) * -1) 0;
    pointer-events: none;
    background:
      linear-gradient(to bottom, color-mix(in srgb, var(--ink) 70%, transparent), transparent 22%),
      linear-gradient(to top, color-mix(in srgb, var(--ink) 82%, transparent), transparent 55%);
  }

  .hm-b {
    position: relative;
    align-self: center;
    flex: 1 1 0;
    min-height: 7rem;
    max-height: min(36svh, 300px);
    aspect-ratio: 0.95;
    margin-block: 0.5rem 1.25rem;
  }

  .hm-b__still {
    display: none;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0.42; /* silueta de fondo, no un sello blanco: el titular sigue siendo lo primero */
    filter: drop-shadow(0 0 22px color-mix(in srgb, var(--cyan) 45%, transparent)) drop-shadow(0 0 60px color-mix(in srgb, var(--magenta) 30%, transparent));
  }
  /* Respaldo: reduced-motion, sin WebGL o fallo de escena (engine.ts marca data-world-fallback) */
  :global(html:has([data-world][data-world-fallback])) .hm-b__still {
    display: block;
  }

  .hm-copy {
    position: relative;
    z-index: var(--z-ui);
    margin-top: auto;
    max-width: 62rem;
  }
  .hm-title {
    font-size: clamp(2.25rem, 10.5vw, 3.5rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .hm-title__thin,
  .hm-title__bold {
    display: block;
  }
  .hm-title__thin {
    font-weight: var(--w-thin);
  }
  .hm-title__bold {
    font-weight: var(--w-bold);
  }
  .hm-sub {
    margin-top: 1.25rem;
    max-width: 34ch;
    font-size: 1.125rem;
    font-weight: var(--w-regular);
    line-height: 1.4;
    color: var(--text-2);
    text-wrap: pretty;
  }

  /* Etiquetas "que hacemos": vidrio tenue, borde con degradado cian a magenta (mascara, para que el
     relleno no se tina) y letra del texto. Compactas: 26 px en movil, 28 px en escritorio. */
  .hm-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.875rem 0 0;
    padding: 0;
    list-style: none;
  }
  /* Etiquetas limpias: texto chico con un filo fino, sin vidrio, sin degradado ni brillo.
     Mismo tamano en escritorio y movil. */
  .hm-pill {
    display: inline-flex;
    align-items: center;
    height: 24px;
    padding-inline: 0.6rem;
    border: 1px solid color-mix(in srgb, var(--text) 18%, transparent);
    border-radius: var(--radius-pill);
    color: var(--text-2);
    font-size: var(--fs-label);
    font-weight: var(--w-medium);
    letter-spacing: 0.02em;
    line-height: 1;
    white-space: nowrap;
  }

  /* ---------- Telefono horizontal: la B a un lado y el titular al otro, todo en una pantalla ---------- */
  @media (max-height: 499px) and (not ((min-width: 1024px) and (min-height: 700px))) {
    .hm {
      flex-direction: row;
      align-items: center;
      gap: 2rem;
      height: auto;
      min-height: calc(100svh - var(--tabbar-h));
      padding-top: calc(var(--header-h) - 0.5rem);
      padding-inline: max(3rem, calc(env(safe-area-inset-left, 0px) + 2rem)) max(1.5rem, env(safe-area-inset-right, 0px));
      /* horizontal puede pasar de una pantalla: aqui el scroll manda (el dedo sigue moviendo el mundo, pasivo) */
      touch-action: auto;
    }
    .hm-b {
      flex: 0 0 auto;
      height: min(50svh, 200px);
      min-height: 0;
      max-height: none;
      margin: 0;
    }
    .hm-copy {
      flex: 1;
      margin-top: 0;
    }
    .hm-title {
      font-size: clamp(1.75rem, 5vw, 2.5rem);
    }
    .hm-sub {
      margin-top: 0.75rem;
      font-size: 1rem;
    }
    .hm-pills {
      margin-top: 0.625rem;
    }
  }

  /* ---------- Escritorio sin scroll (mismo umbral que global.css) ---------- */
  @media (min-width: 1024px) and (min-height: 700px) {
    .hm {
      height: 100%;
      min-height: 0;
      padding: 0;
    }
    .hm-vig {
      inset: 0;
    }
    .hm-b {
      position: absolute;
      left: 50%;
      top: 44%;
      translate: -50% -50%;
      height: min(40vh, 360px);
      margin: 0;
    }
    .hm-copy {
      position: absolute;
      left: 60px;
      right: 60px;
      bottom: 64px;
      max-width: none;
    }
    .hm-title {
      /* 6.2vw con tope de 88px; el limite por alto evita que choque con la B en ventanas bajas */
      font-size: clamp(48px, min(6.2vw, 9.5vh), 88px);
    }
    .hm-sub {
      margin-top: 1.25rem;
      max-width: none;
      font-size: 20px;
    }
    .hm-pills {
      margin-top: 0.875rem;
    }
  }

  /* Ventanas bajas (1024x700): el bloque del titular crece con las etiquetas; la B sube para no rozarlo */
  @media (min-width: 1024px) and (min-height: 700px) and (max-height: 760px) {
    .hm-b {
      top: calc(44% - 40px);
    }
  }
</style>
