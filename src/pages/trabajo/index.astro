---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { brands, NICHOS, TIPOS } from '../../data/brands';
import { TIPO_ICONS } from '../../components/work-icons';
import '../../components/work-styles.css';

/** Ancho de salida de cada logo: suficiente para 2x en la tarjeta de escritorio. */
const logoWidth = (w: number) => Math.min(w, 400);
---

<Base
  title="Trabajo"
  description="Últimos trabajos de iBisne: sitios web, eCommerce, apps y sistemas para marcas de construcción, salud, alimentos, turismo, industria y educación."
  page="trabajo"
>
  <div class="stage work-stage">
    <!-- Velo de legibilidad sobre el mundo 3D (el fondo lo pone el canvas persistente) -->
    <div class="work-veil" data-travel-bg aria-hidden="true"></div>

    <div class="ui-layer work-ui">
      <header>
        <p class="label work-eyebrow" data-travel-ui>Últimos trabajos</p>
        <h1 class="work-title" data-travel-ui data-glitch-text>
          <span class="work-title__thin">Marcas que</span>
          {' '}<span class="work-title__bold">confían en nosotros.</span>
        </h1>
      </header>

      <div class="work-filters" data-travel-ui>
        <!-- Movil: un boton por filtro que abre su hoja de opciones (sin carril horizontal) -->
        <div class="work-triggers">
          <button type="button" class="work-trigger" data-open-filter="nicho" aria-haspopup="dialog">
            <span class="work-trigger__k">Nicho</span>
            <span class="work-trigger__v" data-trigger-value="nicho">Todos</span>
            <svg viewBox="0 0 14 14" aria-hidden="true" focusable="false"><path d="M3.5 5.5 7 9l3.5-3.5" /></svg>
          </button>
          <button type="button" class="work-trigger" data-open-filter="tipo" aria-haspopup="dialog">
            <span class="work-trigger__k">Tipo</span>
            <span class="work-trigger__v" data-trigger-value="tipo">Todos</span>
            <svg viewBox="0 0 14 14" aria-hidden="true" focusable="false"><path d="M3.5 5.5 7 9l3.5-3.5" /></svg>
          </button>
        </div>
        <div class="work-filter" role="group" aria-labelledby="work-f-nicho">
          <span class="work-filter__label" id="work-f-nicho">Nichos</span>
          <div class="work-filter__pills">
            <button type="button" class="work-pill" data-group="nicho" data-value="" aria-pressed="true">Todos</button>
            {
              NICHOS.map((n) => (
                <button type="button" class="work-pill" data-group="nicho" data-value={n} aria-pressed="false">
                  {n}
                </button>
              ))
            }
          </div>
        </div>
        <div class="work-filter" role="group" aria-labelledby="work-f-tipo">
          <span class="work-filter__label" id="work-f-tipo">Tipo</span>
          <div class="work-filter__pills">
            <button type="button" class="work-pill" data-group="tipo" data-value="" aria-pressed="true">Todos</button>
            {
              TIPOS.map((t) => (
                <button type="button" class="work-pill" data-group="tipo" data-value={t} aria-pressed="false">
                  <svg viewBox="0 0 14 14" aria-hidden="true" focusable="false" set:html={TIPO_ICONS[t]} />
                  {t}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <dialog class="work-sheet" data-filter-sheet="nicho" closedby="any" aria-labelledby="work-sheet-nicho">
        <div class="work-sheet__head">
          <h2 class="work-sheet__title" id="work-sheet-nicho">¿Qué nicho buscas?</h2>
          <button type="button" class="work-sheet__close" data-close-sheet aria-label="Cerrar">×</button>
        </div>
        <div class="work-sheet__opts">
          <button type="button" class="work-pill" data-group="nicho" data-value="" aria-pressed="true">Todos</button>
          {
            NICHOS.map((n) => (
              <button type="button" class="work-pill" data-group="nicho" data-value={n} aria-pressed="false">
                {n}
              </button>
            ))
          }
        </div>
      </dialog>
      <dialog class="work-sheet" data-filter-sheet="tipo" closedby="any" aria-labelledby="work-sheet-tipo">
        <div class="work-sheet__head">
          <h2 class="work-sheet__title" id="work-sheet-tipo">¿Qué tipo de proyecto?</h2>
          <button type="button" class="work-sheet__close" data-close-sheet aria-label="Cerrar">×</button>
        </div>
        <div class="work-sheet__opts">
          <button type="button" class="work-pill" data-group="tipo" data-value="" aria-pressed="true">Todos</button>
          {
            TIPOS.map((t) => (
              <button type="button" class="work-pill" data-group="tipo" data-value={t} aria-pressed="false">
                <svg viewBox="0 0 14 14" aria-hidden="true" focusable="false" set:html={TIPO_ICONS[t]} />
                {t}
              </button>
            ))
          }
        </div>
      </dialog>

      <div class="work-gridwrap">
        <p class="sr-only" role="status" aria-live="polite" id="work-status"></p>
        <ul class="work-grid" role="list" aria-label="Marcas con las que hemos trabajado">
          {
            brands.map((b, i) => (
              <li
                class="card work-card"
                data-slug={b.slug}
                data-nicho={b.nicho}
                data-tipos={b.tipos.join('|')}
                data-travel-ui
              >
                <a class="work-card__link" href={`/trabajo/${b.slug}/`} data-astro-prefetch="hover">
                  {b.logo ? (
                    <span class="work-card__logo">
                      <Image
                        src={b.logo}
                        alt={b.name}
                        width={logoWidth(b.logo.width)}
                        loading={i < 12 ? 'eager' : 'lazy'}
                        decoding="async"
                      />
                    </span>
                  ) : (
                    /* LOGO PENDIENTE: wordmark provisional, sustituir por el logo real */
                    <span class="work-ph work-card__logo-ph" data-logo-pending>
                      {b.name}
                    </span>
                  )}
                </a>
                <div class="work-card__actions">
                  <a
                    class="work-btn work-btn--solid"
                    href={`/trabajo/${b.slug}/`}
                    aria-label={`Ver proyecto ${b.name}`}
                    style="--i:0"
                  >
                    Ver proyecto
                  </a>
                  {b.url && (
                    <a
                      class="work-btn work-btn--outline"
                      href={b.url}
                      target="_blank"
                      rel="noopener"
                      aria-label={`Sitio en vivo de ${b.name} (se abre en otra pestaña)`}
                      title="Sitio en vivo"
                      style="--i:1"
                    >
                      <span class="work-btn__t">Sitio en vivo </span>
                      <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</Base>

<script>
  import { initWork } from '../../scripts/work-gallery';

  let cleanup: (() => void) | undefined;
  let mounted: Element | null = null;
  const mount = () => {
    if (document.documentElement.dataset.page !== 'trabajo') return;
    const grid = document.querySelector('.work-grid');
    if (!grid || grid === mounted) return;
    cleanup?.();
    mounted = grid;
    cleanup = initWork();
  };
  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = undefined;
    mounted = null;
  });
  // Carga directa: el estado de la URL se aplica antes de la entrada animada.
  mount();
</script>
