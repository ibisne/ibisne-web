---
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  // Los cuatro documentos legales viven en src/content/legal/*.md
  const docs = import.meta.glob('../../content/legal/*.md', { eager: true }) as Record<string, any>;
  return Object.entries(docs).map(([path, doc]) => ({
    params: { slug: path.split('/').pop()!.replace(/\.md$/, '') },
    props: { doc },
  }));
}

const { slug } = Astro.params;
const { doc } = Astro.props;
const { Content, frontmatter } = doc;
const headings: { depth: number; slug: string; text: string }[] = doc
  .getHeadings()
  .filter((h: { depth: number }) => h.depth === 2);

const others = [
  { slug: 'privacidad', label: 'Aviso de privacidad' },
  { slug: 'terminos', label: 'Términos y condiciones' },
  { slug: 'cookies', label: 'Cookies' },
  { slug: 'aviso-legal', label: 'Aviso legal' },
].filter((o) => o.slug !== slug);
---

<Base title={`${frontmatter.title} · iBisne`} description={frontmatter.description} page="legal" footerLegal={true}>
  <main class="legal" id="contenido">
    <div class="legal-wrap">
      <a class="legal-back" href="/">&larr; Volver al inicio</a>

      <header class="legal-head">
        <p class="legal-kicker">Legal</p>
        <h1>{frontmatter.title}</h1>
        <p class="legal-updated">Última actualización: {frontmatter.updated}</p>
      </header>

      {headings.length > 1 && (
        <nav class="legal-toc" aria-label="Secciones de este documento">
          <p class="legal-toc-title">Contenido</p>
          <ol>
            {headings.map((h) => (
              <li><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ol>
        </nav>
      )}

      <article class="prose">
        <Content />
      </article>

      <nav class="legal-more" aria-label="Otros documentos legales">
        <p class="legal-toc-title">Otros documentos</p>
        <ul>
          {others.map((o) => (
            <li><a href={`/legal/${o.slug}/`}>{o.label}</a></li>
          ))}
        </ul>
        <a class="legal-back" href="/">&larr; Volver al inicio</a>
      </nav>
    </div>
  </main>
</Base>

<script>
  // Cookies: "Cambiar mi elección" borra la decisión guardada y recarga,
  // de modo que el banner vuelve a preguntar y GA no arranca sin permiso.
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement | null)?.closest('[data-consent-reset]');
    if (!btn) return;
    try {
      localStorage.removeItem('ib_consent');
    } catch {
      /* almacenamiento bloqueado: nada que borrar */
    }
    window.location.reload();
  });
</script>

<style>
  .legal {
    min-height: 100dvh;
    background: var(--ink, #0b0820);
    color: var(--text, #f2eeff);
    font-family: 'Geist Variable', 'Geist', system-ui, sans-serif;
    font-size: 17px;
    line-height: 1.7;
    padding: clamp(6rem, 12vh, 8rem) 1.25rem clamp(5rem, 10vh, 7rem);
  }
  .legal-wrap {
    max-width: 72ch;
    margin-inline: auto;
  }

  .legal-back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text-2, rgb(242 238 255 / 0.75));
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .legal-back:hover,
  .legal-back:focus-visible {
    color: var(--text, #f2eeff);
    border-bottom-color: var(--cyan, #4df3ff);
  }

  .legal-head {
    margin-block: 1.5rem 2.25rem;
  }
  .legal-kicker {
    margin: 0 0 0.75rem;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3, rgb(242 238 255 / 0.55));
  }
  .legal-head h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 2.9rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .legal-updated {
    margin: 0.9rem 0 0;
    font-size: 0.9rem;
    color: var(--text-3, rgb(242 238 255 / 0.55));
  }

  .legal-toc,
  .legal-more {
    border-top: 1px solid var(--line, rgb(242 238 255 / 0.1));
    border-bottom: 1px solid var(--line, rgb(242 238 255 / 0.1));
    padding-block: 1.25rem;
  }
  .legal-toc {
    margin-bottom: 2.5rem;
  }
  .legal-toc-title {
    margin: 0 0 0.75rem;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3, rgb(242 238 255 / 0.55));
  }
  .legal-toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
    column-width: 17rem;
    column-gap: 2rem;
  }
  .legal-toc li {
    break-inside: avoid;
  }
  .legal-toc a,
  .legal-more a:not(.legal-back) {
    display: block;
    padding-block: 0.3rem;
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--text-2, rgb(242 238 255 / 0.75));
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .legal-toc a:hover,
  .legal-toc a:focus-visible,
  .legal-more a:not(.legal-back):hover,
  .legal-more a:not(.legal-back):focus-visible {
    color: var(--cyan, #4df3ff);
  }

  .legal-more {
    margin-top: 4rem;
    border-bottom: 0;
  }
  .legal-more ul {
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }

  /* Cuerpo del documento (HTML generado desde Markdown: se usa :global) */
  .prose :global(h2) {
    margin: 2.75rem 0 0.9rem;
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    scroll-margin-top: 6rem;
  }
  .prose :global(h3) {
    margin: 1.75rem 0 0.6rem;
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.35;
    scroll-margin-top: 6rem;
  }
  .prose :global(p),
  .prose :global(li) {
    color: var(--text-2, rgb(242 238 255 / 0.75));
  }
  .prose :global(p) {
    margin: 0 0 1.1rem;
  }
  .prose :global(ul) {
    margin: 0 0 1.25rem;
    padding-left: 1.25rem;
  }
  .prose :global(li) {
    margin-bottom: 0.55rem;
    padding-left: 0.25rem;
  }
  .prose :global(li)::marker {
    color: var(--text-3, rgb(242 238 255 / 0.55));
  }
  .prose :global(strong) {
    color: var(--text, #f2eeff);
    font-weight: 600;
  }
  .prose :global(a) {
    color: var(--text, #f2eeff);
    text-decoration: underline;
    text-decoration-color: var(--cyan, #4df3ff);
    text-underline-offset: 0.2em;
  }
  .prose :global(a:hover) {
    color: var(--cyan, #4df3ff);
  }
  .prose :global(code) {
    padding: 0.1em 0.4em;
    border-radius: 6px;
    background: var(--line, rgb(242 238 255 / 0.1));
    color: var(--text, #f2eeff);
    font-size: 0.9em;
  }
  .prose :global(.legal-action) {
    margin: 1.5rem 0;
  }
  .prose :global(.legal-btn) {
    min-height: 44px;
    padding: 0 1.4rem;
    border: 1px solid var(--text, #f2eeff);
    border-radius: 999px;
    background: transparent;
    color: var(--text, #f2eeff);
    font: inherit;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .prose :global(.legal-btn:hover),
  .prose :global(.legal-btn:focus-visible) {
    background: var(--text, #f2eeff);
    color: var(--ink, #0b0820);
  }

  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--cyan, #4df3ff);
    outline-offset: 3px;
  }

  @media (min-width: 720px) {
    .legal {
      padding-inline: 2rem;
    }
  }
</style>
