---
import Base from '../../layouts/Base.astro';
import ContactOption from '../../components/contact-option.astro';
import {
  OPTIONS,
  WA_BASE,
  PHONE_LABEL,
  PHONE_HREF,
  EMAIL,
  INSTAGRAM,
  FACEBOOK,
  WHATSAPP_ICON,
  SOCIAL_ICONS,
} from '../../components/contact-data';
---

<Base
  title="Contacto · iBisne"
  description="Escríbenos por WhatsApp al 33 3723 7525 o a proyectos@ibisne.com. iBisne · Zapopan, Jalisco."
  page="contacto"
>
  <div class="stage ct" data-travel-self>
    <!-- El fondo es el mundo WebGL persistente (estacion contacto). Este velo solo da contraste al texto. -->
    <div class="ct__veil" data-ct-veil aria-hidden="true"></div>

    <div class="ui-layer ct__ui">
      <section class="ct__left" aria-labelledby="ct-title">
        <div class="ct__head" data-ct-in>
          <p class="label ct__eyebrow">Contacto</p>
          <h1 id="ct-title" class="title ct__title">
            <span class="title__thin">Hablemos de</span>
            <span class="title__bold">lo que sigue.</span>
          </h1>
          <p class="ct__lead">
            <span class="ct__lead-long">Cuéntanos tu idea por WhatsApp. Te responde una persona del equipo.</span>
            <span class="ct__lead-short">Elige un tema y te abrimos WhatsApp.</span>
          </p>
        </div>

        <div class="ct__cta" data-ct-in>
          <a class="ct__wa" href={WA_BASE} target="_blank" rel="noopener">
            <svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={WHATSAPP_ICON} />
            <span>Escríbenos por WhatsApp</span>
          </a>
          <a class="ct__tel" href={PHONE_HREF}>{PHONE_LABEL}</a>
        </div>

        <!-- Escritorio: tarjeta de datos -->
        <div class="card ct__info only-lock" data-ct-in>
          <dl class="ct__rows">
            <div class="ct__row">
              <dt class="ct__k">Correo</dt>
              <dd><a class="ct__v" href={`mailto:${EMAIL}`}>{EMAIL}</a></dd>
            </div>
            <div class="ct__row">
              <dt class="ct__k">Redes</dt>
              <dd class="ct__social">
                <a class="ct__v" href={INSTAGRAM.href} target="_blank" rel="noopener"><span>Instagram</span> {INSTAGRAM.handle}</a>
                <a class="ct__v" href={FACEBOOK.href} target="_blank" rel="noopener"><span>Facebook</span> {FACEBOOK.handle}</a>
              </dd>
            </div>
            <div class="ct__row">
              <dt class="ct__k">Estudio</dt>
              <dd class="ct__v">Zapopan, Jalisco</dd>
            </div>
          </dl>
        </div>

        <!-- Movil: WhatsApp y los demas canales en UNA fila (sin tarjeta, sin scroll) -->
        <div class="ct__links only-scroll" data-ct-in>
          <a class="ct__wa ct__wa--row" href={WA_BASE} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
            <svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={WHATSAPP_ICON} />
            <span class="ct__wa-label">WhatsApp</span>
          </a>
          <a class="ct__ic" href={PHONE_HREF} aria-label={`Llamar al ${PHONE_LABEL}`}>
            <svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={SOCIAL_ICONS.phone} />
          </a>
          <a class="ct__ic" href={`mailto:${EMAIL}`} aria-label={`Correo ${EMAIL}`}>
            <svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={SOCIAL_ICONS.mail} />
          </a>
          <a class="ct__ic" href={INSTAGRAM.href} target="_blank" rel="noopener" aria-label={`Instagram ${INSTAGRAM.handle}`}>
            <svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={SOCIAL_ICONS.instagram} />
          </a>
          <a class="ct__ic" href={FACEBOOK.href} target="_blank" rel="noopener" aria-label={`Facebook ${FACEBOOK.handle}`}>
            <svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={SOCIAL_ICONS.facebook} />
          </a>
        </div>
      </section>

      <section class="ct__right" aria-labelledby="ct-q">
        <h2 id="ct-q" class="ct__q" data-ct-in><span class="ct__q-thin">¿Qué te</span> <strong>interesa</strong><span class="ct__q-thin">?</span></h2>
        <ul class="ct__opts" role="list">
          {OPTIONS.map((o) => <li><ContactOption option={o} /></li>)}
        </ul>
      </section>
    </div>
  </div>
</Base>

<style>
  .ct {
    --pad-x: clamp(1.5rem, 4.1667vw, 5rem);
  }

  /* ---------- Velo de contraste (el fondo vive en el mundo WebGL) ---------- */
  .ct__veil {
    position: fixed; /* movil: cubre tambien el pie, que queda fuera de .stage */
    inset: 0;
    z-index: var(--z-bg);
    pointer-events: none;
    background:
      linear-gradient(to bottom, color-mix(in srgb, var(--ink) 55%, transparent), transparent 24%),
      linear-gradient(to top, color-mix(in srgb, var(--ink) 80%, transparent), transparent 34%),
      color-mix(in srgb, var(--ink) 34%, transparent);
  }

  /* ---------- Columnas (movil: una sola, compacta, en orden de lectura) ---------- */
  .ct__ui {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: calc(var(--header-h) + 0.25rem) var(--gutter) 12px;
  }
  .ct__left {
    display: contents;
  }
  .ct__head {
    order: 1;
  }
  .ct__right {
    order: 2;
  }
  .ct__cta {
    order: 3;
  }
  .ct__links {
    order: 4;
  }
  .ct__info {
    order: 5;
  }

  .ct__eyebrow {
    line-height: 16px;
    color: var(--cyan);
    margin-bottom: 8px;
  }
  .ct__title {
    font-size: clamp(2rem, 9.6vw, 2.75rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
  }
  .ct__lead {
    margin-top: 8px;
    max-width: 30rem;
    font-size: 14px;
    line-height: 20px;
    font-weight: var(--w-light);
    color: var(--text-2);
    text-wrap: pretty;
  }
  .ct__lead-long {
    display: none;
  }

  /* CTA */
  .ct__cta {
    display: block;
  }
  .ct__wa {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    min-height: 52px;
    padding: 0 24px;
    border-radius: var(--radius-pill);
    background: var(--text);
    color: var(--ink);
    font-size: 15px;
    font-weight: var(--w-medium);
    line-height: 20px;
    white-space: nowrap;
    transition:
      box-shadow 0.25s var(--ease-out),
      transform 0.25s var(--ease-out);
  }
  .ct__wa:is(:hover, :focus-visible) {
    box-shadow: 0 0 28px color-mix(in srgb, var(--cyan) 35%, transparent);
  }
  .ct__wa:active {
    transform: translateY(1px) scale(0.99);
  }
  .ct__tel {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    font-size: 16px;
    letter-spacing: 0.02em;
    color: var(--text-2);
    transition: color 0.2s;
  }
  .ct__tel:hover {
    color: var(--text);
  }
  /* El telefono vive en la fila de iconos */
  .ct__cta .ct__tel {
    display: none;
  }

  /* Fila de iconos (movil) */
  .ct__links {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .ct__ic {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--text) 14%, transparent);
    background: var(--glass);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    color: var(--text-2);
    transition:
      color 0.2s,
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .ct__ic:is(:hover, :active) {
    color: var(--cyan);
    border-color: color-mix(in srgb, var(--cyan) 90%, transparent);
  }
  /* WhatsApp dentro de la fila: ocupa lo que dejan los iconos */
  .ct__wa--row {
    flex: 1;
    min-width: 0;
    width: auto;
    min-height: 44px;
    padding: 0 16px;
    font-size: 14px;
  }

  /* Tarjeta de datos: no es un enlace, no reacciona al hover de .card */
  .ct__info.card,
  .ct__info.card:hover {
    background: var(--glass);
    border-color: color-mix(in srgb, var(--text) 14%, transparent);
    box-shadow: none;
  }
  .ct__info {
    width: 100%;
    max-width: 460px;
    padding: var(--ct-info-pad, 24px);
  }
  .ct__rows {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .ct__row + .ct__row {
    margin-top: var(--ct-info-gap, 16px);
    padding-top: var(--ct-info-gap, 16px);
    border-top: 1px solid var(--line);
  }
  .ct__k {
    margin-bottom: 6px;
    font-size: 11px;
    line-height: 14px;
    font-weight: var(--w-medium);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-3);
  }
  .ct__row dd {
    margin: 0;
    font-size: 16px;
    line-height: 21px;
  }
  .ct__social {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .ct__v {
    font-size: 16px;
    line-height: 21px;
    color: var(--text);
  }
  a.ct__v {
    align-self: flex-start;
    transition: color 0.2s;
  }
  a.ct__v:hover {
    color: var(--cyan);
  }
  .ct__v span {
    color: var(--text-3);
  }

  /* Pregunta + opciones */
  .ct__q {
    margin-bottom: 1.25rem;
    font-size: clamp(1.75rem, 8vw, 2rem);
    line-height: 1.3125;
    letter-spacing: -0.02em;
    font-weight: var(--w-thin);
  }
  .ct__q strong {
    font-weight: var(--w-bold);
  }
  .ct__opts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    list-style: none;
    padding: 0;
  }
  .ct__opts > li {
    display: flex;
  }
  .ct__opts :global(.opt) {
    width: 100%;
  }

  /* ---------- Movil/tablet: cabe en ~1 pantalla ---------- */
  @media not ((min-width: 1024px) and (min-height: 700px)) {
    .ct__lead-long {
      display: none;
    }
    .ct__lead-short {
      display: inline;
    }
    /* La pregunta queda para lectores de pantalla: el subtitulo ya la formula */
    .ct__q {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .ct__opts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }
    /* El CTA grande vive en la fila de iconos */
    .ct__cta {
      display: none;
    }
  }
  /* Telefonos angostos: el boton de WhatsApp queda solo con su icono */
  @media (max-width: 359px) {
    .ct__wa--row {
      flex: 0 0 64px;
      padding: 0;
    }
    .ct__wa-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  /* Pantallas bajas (telefonos chicos, o navegador con barras): todo cabe en una pantalla */
  @media (max-height: 760px) and (not ((min-width: 1024px) and (min-height: 700px))) {
    .ct__ui {
      gap: 12px;
      padding-top: calc(var(--header-h) - 0.25rem);
    }
    .ct__eyebrow {
      display: none;
    }
    .ct__title {
      font-size: clamp(1.75rem, 8vw, 2.25rem);
    }
    .ct__lead {
      margin-top: 6px;
    }
    .ct__opts {
      gap: 6px;
    }
  }
  @media (max-height: 620px) and (not ((min-width: 1024px) and (min-height: 700px))) {
    .ct__ui {
      gap: 10px;
    }
    .ct__lead {
      display: none;
    }
  }
  @media (min-width: 640px) and (not ((min-width: 1024px) and (min-height: 700px))) {
    .ct__ui {
      width: 100%;
      max-width: 640px;
      margin-inline: auto;
    }
  }

  /* ---------- Escritorio sin scroll (identico a Figma 46:2 a 1440x900) ---------- */
  @media (min-width: 1024px) and (min-height: 700px) {
    .ct {
      min-height: 0;
      height: 100%;
    }
    .ct__veil {
      position: absolute;
      background:
        linear-gradient(90deg, color-mix(in srgb, var(--ink) 62%, transparent) 0%, color-mix(in srgb, var(--ink) 40%, transparent) 38%, transparent 64%),
        linear-gradient(to top, color-mix(in srgb, var(--ink) 55%, transparent), transparent 22%);
    }
    .ct__ui {
      display: grid;
      height: 100%;
      grid-template-columns: minmax(0, 38fr) minmax(0, 62fr);
      column-gap: 2.5rem;
      align-content: start;
      align-items: start;
      padding: max(calc(var(--header-h) + 1rem), 13.333dvh) var(--pad-x) 0;
      --ct-info-pad: clamp(15px, calc(2.8dvh - 1px), 24px);
      --ct-info-gap: clamp(10px, 1.8dvh, 16px);
    }
    .ct__left {
      display: flex;
      flex-direction: column;
      gap: clamp(1.25rem, 3.33dvh, 1.875rem);
    }
    .ct__head,
    .ct__cta,
    .ct__right,
    .ct__info {
      order: 0;
    }
    .ct__eyebrow {
      margin-bottom: clamp(0.5rem, 1.55dvh, 0.875rem);
    }
    .ct__title {
      font-size: clamp(2.25rem, min(6.2dvh, 3.9vw), 3.5rem);
    }
    .ct__lead {
      margin-top: clamp(0.5rem, 1.55dvh, 0.875rem);
      max-width: 29.4rem;
      font-size: clamp(1rem, 2dvh, 1.125rem);
      line-height: 1.28;
    }
    .ct__lead-long {
      display: inline;
    }
    .ct__lead-short {
      display: none;
    }
    .ct__cta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.875rem 1.125rem;
    }
    .ct__wa {
      display: inline-flex;
      width: auto;
      min-height: 48px;
    }
    .ct__cta .ct__tel {
      display: inline-flex;
    }
    .ct__q {
      margin-bottom: clamp(1rem, 2.9dvh, 1.625rem);
      font-size: clamp(1.625rem, 3.56dvh, 2rem);
    }
    .ct__opts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px 16px;
    }
  }

  @media (min-width: 1360px) and (min-height: 700px) {
    .ct__ui {
      grid-template-columns: minmax(0, 470px) minmax(0, 680px);
      justify-content: space-between;
    }
  }

  @media (min-width: 1024px) and (min-height: 700px) and (max-width: 1180px) {
    .ct__cta {
      gap: 0.5rem 1rem;
    }
  }
</style>

<style is:global>
  /* Pie legal de Contacto: en escritorio sin scroll, discreto y alineado a la columna izquierda */
  @media (min-width: 1024px) and (min-height: 700px) {
    html[data-page='contacto'] .legal-foot {
      padding: 0 clamp(1.5rem, 4.1667vw, 5rem) 1.25rem;
    }
    html[data-page='contacto'] .legal-foot a {
      min-height: 1.75rem;
    }
  }

  /* Movil: legales en una linea pequena. --tabbar-h = barra inferior fija + safe-area (global.css) */
  @media not ((min-width: 1024px) and (min-height: 700px)) {
    html[data-page='contacto'] .legal-foot {
      justify-content: center;
      gap: 0;
      padding: 0 var(--gutter) calc(var(--tabbar-h) + 8px);
      text-align: center;
    }
    html[data-page='contacto'] .legal-foot nav {
      flex-wrap: nowrap;
      justify-content: center;
      gap: 0 0.3rem;
      width: 100%;
    }
    html[data-page='contacto'] .legal-foot a {
      min-height: 32px;
      font-size: 10px;
      letter-spacing: 0;
      white-space: nowrap;
    }
    html[data-page='contacto'] .legal-foot p {
      font-size: 10px;
      line-height: 14px;
    }
  }
  @media (max-width: 340px) and (not ((min-width: 1024px) and (min-height: 700px))) {
    html[data-page='contacto'] .legal-foot a {
      font-size: 9px;
    }
  }
</style>

<script>
  import { initContactMotion } from '../../scripts/contact-enter';

  // Entrada en cascada tras el viaje del mundo; salida al empezar un viaje desde Contacto.
  initContactMotion();
</script>
