---
import { Image } from 'astro:assets';
import logo from '../assets/brand/ibisne-blanco.png';
import SoundToggle from './SoundToggle.astro';

const path = Astro.url.pathname;
const current = path === '/' ? 'home' : path.startsWith('/trabajo') ? 'trabajo' : path.startsWith('/contacto') ? 'contacto' : '';
const WA = 'https://wa.me/523337237525';
const links = [
  { href: '/', id: 'home', label: 'Inicio' },
  { href: '/trabajo/', id: 'trabajo', label: 'Trabajo' },
  { href: '/contacto/', id: 'contacto', label: 'Contacto' },
];
---

<header class="hdr" transition:persist="hdr">
  <a class="hdr__logo" href="/" aria-label="iBisne, ir al inicio">
    <!-- Logo completo oficial (blanco, recortado: 794x208). Alto fijado en CSS; width/height reservan el sitio. -->
    <Image src={logo} alt="iBisne" width={115} densities={[1, 2, 3]} loading="eager" decoding="async" fetchpriority="high" />
  </a>

  <nav class="hdr__nav" aria-label="Principal">
    {
      links.map((l) => (
        <a class="hdr__link label" href={l.href} data-nav={l.id} aria-current={current === l.id ? 'page' : undefined}>
          {l.label}
        </a>
      ))
    }
    <!-- Indicador unico del item activo: se desliza (transform) hacia el nuevo item; el script lo posiciona -->
    <span class="hdr__ind" aria-hidden="true"></span>
  </nav>

  <div class="hdr__end">
    <SoundToggle />
    <a class="btn btn-outline hdr__cta" href={WA} target="_blank" rel="noopener">
      Hablemos <span class="btn__arrow" aria-hidden="true">↳</span>
    </a>
  </div>
</header>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-header);
    height: var(--header-h);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-inline: var(--gutter);
    pointer-events: none; /* solo los enlaces reciben clics */
  }
  .hdr > * {
    pointer-events: auto;
  }
  .hdr__logo {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
  }
  .hdr__logo img {
    width: auto;
    height: 30px; /* escritorio */
  }
  .hdr__nav {
    position: relative;
    display: flex;
    gap: clamp(1rem, 2.5vw, 2.5rem);
  }
  .hdr__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    padding-inline: 0.25rem;
    color: var(--text-3);
    transition: color 0.3s var(--ease-out);
  }
  .hdr__link:hover {
    color: var(--text);
  }
  .hdr__link[aria-current='page'] {
    color: var(--text);
  }
  /* Indicador del item activo: UNA sola raya que viaja de un item al otro. Solo se anima
     transform (el ancho de los items no cambia) y arranca al tocar, junto con el viaje. */
  .hdr__ind {
    position: absolute;
    left: 0;
    bottom: 0.45rem;
    width: 16px;
    height: 2px;
    border-radius: 2px;
    background: var(--grad-accent);
    pointer-events: none;
    opacity: 0;
    transform: translateX(var(--ind-x, 0px));
    transition:
      transform 0.3s var(--ease-out),
      opacity 0.2s;
  }
  .hdr__ind[data-on] {
    opacity: 1;
  }
  .hdr__ind[data-snap] {
    transition: none;
  }
  /* Sin JS no hay indicador deslizante: se conserva la raya fija bajo el item activo */
  .hdr:not([data-js]) .hdr__link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.45rem;
    width: 16px;
    height: 2px;
    border-radius: 2px;
    background: var(--grad-accent);
    transform: translateX(-50%);
  }
  .hdr__end {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Movil (modo scroll): el logo y, a la derecha, el control de sonido. La navegacion vive en la barra
     inferior (MobileTabBar); el control no flota sobre el contenido (tapaba las pills de Inicio). */
  @media not ((min-width: 1024px) and (min-height: 700px)) {
    .hdr {
      /* logo a la izquierda; a la derecha solo el control de sonido */
      grid-template-columns: 1fr auto;
      /* el contenido que scrollea pasa por debajo del logo: velo casi opaco arriba para que no se mezclen */
      background: linear-gradient(to bottom, var(--ink), color-mix(in srgb, var(--ink) 88%, transparent) 55%, transparent);
    }
    .hdr__logo img {
      height: 25px; /* movil */
    }
    .hdr__nav,
    .hdr__cta {
      display: none;
    }
  }
</style>

<script>
  const idFor = (pathname: string): string =>
    pathname === '/' ? 'home' : pathname.startsWith('/trabajo') ? 'trabajo' : pathname.startsWith('/contacto') ? 'contacto' : '';

  const header = (): HTMLElement | null => document.querySelector<HTMLElement>('.hdr');

  /** Marca el item activo (solo escribe si cambia: nada de quitar y poner el mismo atributo) y desliza el indicador. */
  function setActive(id: string, snap = false): void {
    const hdr = header();
    if (!hdr) return;
    let target: HTMLAnchorElement | null = null;
    for (const a of hdr.querySelectorAll<HTMLAnchorElement>('.hdr__link')) {
      const on = a.dataset.nav === id;
      if (on) target = a;
      if (on !== a.hasAttribute('aria-current')) {
        if (on) a.setAttribute('aria-current', 'page');
        else a.removeAttribute('aria-current');
      }
    }
    placeIndicator(target, snap);
  }

  function placeIndicator(target: HTMLAnchorElement | null, snap: boolean): void {
    const ind = header()?.querySelector<HTMLElement>('.hdr__ind');
    if (!ind) return;
    if (!target || !target.offsetWidth) {
      // legales / 404 (sin item) o nav oculto (movil): sin raya
      if (ind.hasAttribute('data-on')) ind.removeAttribute('data-on');
      return;
    }
    const x = target.offsetLeft + target.offsetWidth / 2 - ind.offsetWidth / 2;
    // viniendo de "sin item" (legales / 404) la raya aparece en su sitio en vez de cruzar desde la izquierda
    if (snap || !ind.hasAttribute('data-on')) {
      ind.setAttribute('data-snap', '');
      ind.style.setProperty('--ind-x', `${x}px`);
      void ind.offsetWidth; // aplica el salto sin transicion
      ind.removeAttribute('data-snap');
    } else {
      ind.style.setProperty('--ind-x', `${x}px`);
    }
    ind.setAttribute('data-on', '');
  }

  function current(): HTMLAnchorElement | null {
    return header()?.querySelector<HTMLAnchorElement>('.hdr__link[aria-current="page"]') ?? null;
  }

  const hdr = header();
  if (hdr) {
    hdr.setAttribute('data-js', '');
    setActive(idFor(location.pathname), true);
    // el indicador espera a que Geist cargue: los anchos de los items cambian con la fuente
    void document.fonts?.ready.then(() => placeIndicator(current(), true));
    const nav = hdr.querySelector('.hdr__nav');
    if (nav && 'ResizeObserver' in window) new ResizeObserver(() => placeIndicator(current(), true)).observe(nav);
  }

  // Respuesta inmediata, como la barra movil: el indicador sale al tocar, a la vez que el viaje
  // (antes esperaba al cambio de DOM, ~1.4 s despues del toque).
  document.addEventListener('astro:before-preparation', (ev) => {
    const to = (ev as Event & { to?: URL }).to;
    if (to) setActive(idFor(to.pathname));
  });
  // Red de seguridad: si la navegacion fallo o llego por atras/adelante, se alinea con la URL real.
  document.addEventListener('astro:page-load', () => setActive(idFor(location.pathname)));
</script>
