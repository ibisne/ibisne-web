---
import { Image } from 'astro:assets';
import bLogo from '../assets/b/b-trim.png';

const path = Astro.url.pathname;
const current = path === '/' ? 'home' : path.startsWith('/trabajo') ? 'trabajo' : path.startsWith('/contacto') ? 'contacto' : '';
const WA = 'https://wa.me/523337237525';
const links = [
  { href: '/', id: 'home', label: 'Inicio' },
  { href: '/trabajo/', id: 'trabajo', label: 'Trabajo' },
  { href: '/contacto/', id: 'contacto', label: 'Contacto' },
];
---

<header class="hdr" transition:persist="hdr">
  <a class="hdr__logo" href="/" aria-label="iBisne, ir al inicio">
    <Image src={bLogo} alt="" width={26} height={28} densities={[1, 2]} loading="eager" decoding="async" />
    <span>iBisne</span>
  </a>

  <nav class="hdr__nav" aria-label="Principal">
    {
      links.map((l) => (
        <a class="hdr__link label" href={l.href} data-nav={l.id} aria-current={current === l.id ? 'page' : undefined}>
          {l.label}
        </a>
      ))
    }
  </nav>

  <a class="btn btn-outline hdr__cta" href={WA} target="_blank" rel="noopener">
    Hablemos <span class="btn__arrow" aria-hidden="true">↳</span>
  </a>
</header>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-header);
    height: var(--header-h);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-inline: var(--gutter);
    pointer-events: none; /* solo los enlaces reciben clics */
  }
  .hdr > * {
    pointer-events: auto;
  }
  .hdr__logo {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: var(--touch);
    font-weight: var(--w-bold);
    font-size: 1.15rem;
    letter-spacing: -0.01em;
  }
  .hdr__logo img {
    width: 26px;
    height: 28px;
  }
  .hdr__nav {
    display: flex;
    gap: clamp(1rem, 2.5vw, 2.5rem);
  }
  .hdr__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    padding-inline: 0.25rem;
    color: var(--text-3);
    transition: color 0.2s;
  }
  .hdr__link::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.45rem;
    width: 16px;
    height: 2px;
    border-radius: 2px;
    background: var(--grad-accent);
    transform: translateX(-50%) scaleX(0);
    transition: transform 0.35s var(--ease-out);
  }
  .hdr__link:hover {
    color: var(--text);
  }
  .hdr__link[aria-current='page'] {
    color: var(--text);
  }
  .hdr__link[aria-current='page']::after {
    transform: translateX(-50%) scaleX(1);
  }
  .hdr__cta {
    justify-self: end;
  }

  /* Telefono: dos filas (logo + boton / nav) */
  @media (max-width: 639px) {
    .hdr {
      grid-template-columns: 1fr auto;
      grid-template-rows: 3.5rem 2.75rem;
      align-content: start;
      padding-top: 0.25rem;
      background: linear-gradient(to bottom, rgb(11 8 32 / 0.92), rgb(11 8 32 / 0));
    }
    .hdr__nav {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-content: center;
      gap: 1.75rem;
    }
    .hdr__cta {
      padding-inline: 1.1rem;
    }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .hdr__cta {
      padding-inline: 1.1rem;
    }
  }
</style>

<script>
  function syncNav(): void {
    const path = location.pathname;
    const id = path === '/' ? 'home' : path.startsWith('/trabajo') ? 'trabajo' : path.startsWith('/contacto') ? 'contacto' : '';
    for (const a of document.querySelectorAll<HTMLAnchorElement>('.hdr__link')) {
      if (a.dataset.nav === id) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    }
  }
  syncNav();
  document.addEventListener('astro:after-swap', syncNav);
  document.addEventListener('astro:page-load', syncNav);
</script>
