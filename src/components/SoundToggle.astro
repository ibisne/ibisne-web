---
/**
 * Control de sonido (musica ambiental, src/scripts/ambient.ts). Vive en el header: en escritorio
 * junto a "Hablemos"; en movil, a la derecha del logo (un boton flotante sobre la barra inferior
 * tapaba las pills de Inicio). Nace con `hidden`: sin JS no hay musica ni control. entry.ts lo
 * muestra al terminar la entrada y sincroniza aria-pressed (true = suena).
 */
---

<button
  type="button"
  class="snd"
  data-sound-toggle
  aria-pressed="false"
  aria-label="Música ambiental"
  title="Música ambiental"
  hidden
>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path class="snd__body" d="M4.5 9.5h3l4.5-3.8v12.6l-4.5-3.8h-3a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1Z"></path>
    <path class="snd__on" d="M15.5 9.2a4 4 0 0 1 0 5.6M18 6.8a7.4 7.4 0 0 1 0 10.4"></path>
    <path class="snd__off" d="m15.5 9.8 4.4 4.4m0-4.4-4.4 4.4"></path>
  </svg>
</button>

<style>
  .snd {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: var(--touch);
    height: var(--touch);
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: color-mix(in srgb, var(--ink) 45%, transparent);
    color: var(--text-2);
    transition:
      border-color 0.25s var(--ease-out),
      color 0.25s var(--ease-out),
      box-shadow 0.25s var(--ease-out);
  }
  .snd:hover,
  .snd:focus-visible {
    color: var(--text);
    border-color: var(--cyan);
    box-shadow: 0 0 20px color-mix(in srgb, var(--cyan) 22%, transparent);
  }
  .snd[aria-pressed='true'] {
    color: var(--cyan);
    border-color: color-mix(in srgb, var(--cyan) 55%, transparent);
  }
  .snd svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .snd__on {
    display: none;
  }
  .snd[aria-pressed='true'] .snd__on {
    display: inline;
  }
  .snd[aria-pressed='true'] .snd__off {
    display: none;
  }
</style>
