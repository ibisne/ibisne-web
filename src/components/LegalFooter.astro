<footer class="legal-foot">
  <nav aria-label="Legales">
    <a href="/legal/privacidad/">Aviso de privacidad</a>
    <span aria-hidden="true">·</span>
    <a href="/legal/terminos/">Términos y condiciones</a>
    <span aria-hidden="true">·</span>
    <a href="/legal/cookies/">Cookies</a>
    <span aria-hidden="true">·</span>
    <a href="/legal/aviso-legal/">Aviso legal</a>
  </nav>
  <p>© 2026 iBisne S.A.S. de C.V.</p>
</footer>

<style is:global>
  .legal-foot {
    position: relative;
    z-index: var(--z-ui);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    padding: 1rem var(--gutter) calc(1rem + env(safe-area-inset-bottom));
    font-size: 11px;
    letter-spacing: 0.02em;
    color: var(--text-3);
  }
  .legal-foot nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.6rem;
  }
  .legal-foot a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    transition: color 0.2s;
  }
  .legal-foot a:hover {
    color: var(--text);
  }

  /* Sin scroll (escritorio): el pie de Contacto flota abajo; en el resto, va al final del flujo */
  @media (min-width: 1024px) and (min-height: 700px) {
    html[data-page='contacto'] .legal-foot {
      position: fixed;
      inset: auto 0 0 0;
    }
  }
</style>
