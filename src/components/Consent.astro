---
---

<aside class="consent" id="consent" role="dialog" aria-label="Preferencias de cookies" hidden transition:persist="consent">
  <p class="consent__text">
    Usamos cookies de analítica solo si aceptas.
    <a href="/legal/privacidad/">Aviso de privacidad</a>
  </p>
  <div class="consent__actions">
    <button type="button" class="btn btn-solid" data-consent="all">Aceptar</button>
    <button type="button" class="btn btn-outline" data-consent="essential">Solo esenciales</button>
  </div>
</aside>

<style>
  .consent {
    position: fixed;
    z-index: var(--z-consent);
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    width: min(22.5rem, calc(100% - 2rem));
    display: grid;
    gap: 0.7rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: rgb(11 8 32 / 0.92);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    font-size: 13px;
    line-height: 1.45;
    color: var(--text-2);
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.45);
    animation: consent-in 0.4s var(--ease-out) both;
  }
  .consent[hidden] {
    display: none;
  }
  .consent__text {
    margin: 0;
  }
  .consent__text a {
    display: inline-block;
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--line-strong);
    white-space: nowrap;
  }
  .consent__actions {
    display: flex;
    gap: 0.5rem;
  }
  .consent__actions .btn {
    flex: 1;
    min-height: 2.25rem;
    padding: 0 0.8rem;
    font-size: 13px;
    white-space: nowrap;
  }
  @keyframes consent-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  /* Movil: barra inferior compacta, texto y botones en una fila */
  @media (max-width: 639px) {
    .consent {
      right: 0;
      left: 0;
      bottom: 0;
      width: auto;
      border-width: 1px 0 0;
      border-radius: 1rem 1rem 0 0;
      padding: 0.7rem 1rem max(0.7rem, env(safe-area-inset-bottom));
      gap: 0.5rem;
    }
    .consent__actions .btn {
      min-height: var(--touch);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .consent {
      animation: none;
    }
  }
</style>

<script>
  import '../scripts/consent.ts';
</script>
