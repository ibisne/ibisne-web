---
---

<aside class="consent glass" id="consent" role="dialog" aria-label="Preferencias de cookies" hidden transition:persist="consent">
  <p class="consent__text">
    Usamos cookies de analítica solo si aceptas.
    <a href="/legal/privacidad/">Aviso de privacidad</a>
  </p>
  <div class="consent__actions">
    <button type="button" class="btn btn-outline" data-consent="essential">Solo esenciales</button>
    <button type="button" class="btn btn-solid" data-consent="all">Aceptar</button>
  </div>
</aside>

<style>
  .consent {
    position: fixed;
    z-index: var(--z-consent);
    left: 50%;
    bottom: max(1rem, env(safe-area-inset-bottom));
    width: min(44rem, calc(100% - 2rem));
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    padding: 0.85rem 0.85rem 0.85rem 1.4rem;
    border-radius: 1.5rem;
    font-size: 0.875rem;
    color: var(--text-2);
    box-shadow: 0 20px 60px rgb(0 0 0 / 0.45);
    animation: consent-in 0.5s var(--ease-out) both;
  }
  .consent__text a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--line-strong);
    white-space: nowrap;
  }
  .consent__actions {
    display: flex;
    gap: 0.5rem;
    flex: none;
  }
  @keyframes consent-in {
    from {
      opacity: 0;
      transform: translate(-50%, 12px);
    }
  }
  @media (max-width: 639px) {
    .consent {
      flex-direction: column;
      align-items: stretch;
      padding: 1rem;
    }
    .consent__actions .btn {
      flex: 1;
    }
  }
</style>

<script>
  import '../scripts/consent.ts';
</script>
