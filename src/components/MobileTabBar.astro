---
/**
 * Capsula flotante de navegacion, solo iconos. Solo se ve en modo scroll (movil, o ventana menor a
 * 1024x700); en escritorio el header lleva la navegacion. Persiste entre paginas (ClientRouter) y su
 * script marca la pestana activa y desliza el indicador. Medidas: --tabbar-bottom / --tabbar-cap-h /
 * --tabbar-h (global.css). Icono + palabra debajo; el aria-label da el nombre accesible.
 */
---

<nav class="tabbar" aria-label="Navegación móvil" transition:persist="tabbar">
  <span class="tabbar__ind" aria-hidden="true"></span>

  <a class="tab" href="/" data-tab="home" data-i="0" aria-label="Inicio">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M4 11.2 12 4l8 7.2V19a1.5 1.5 0 0 1-1.5 1.5H15v-5.2a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v5.2H5.5A1.5 1.5 0 0 1 4 19Z"></path>
    </svg>
    <span class="tab__label" aria-hidden="true">Inicio</span>
  </a>

  <a class="tab" href="/trabajo/" data-tab="trabajo" data-i="1" aria-label="Trabajo">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <rect x="4" y="4" width="6.5" height="6.5" rx="1.6"></rect>
      <rect x="13.5" y="4" width="6.5" height="6.5" rx="1.6"></rect>
      <rect x="4" y="13.5" width="6.5" height="6.5" rx="1.6"></rect>
      <rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.6"></rect>
    </svg>
    <span class="tab__label" aria-hidden="true">Trabajo</span>
  </a>

  <a class="tab" href="/contacto/" data-tab="contacto" data-i="2" aria-label="Contacto">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <rect x="3.5" y="5.5" width="17" height="13" rx="2.2"></rect>
      <path d="m4.5 7.5 7.5 5.7 7.5-5.7"></path>
    </svg>
    <span class="tab__label" aria-hidden="true">Contacto</span>
  </a>
</nav>

<style>
  .tabbar {
    display: none;
  }

  @media not ((min-width: 1024px) and (min-height: 700px)) {
    .tabbar {
      --tab: 60px; /* ancho del toque (cabe "Contacto") */
      --tab-h: 52px; /* alto del toque: 44 minimo */
      --tab-gap: 2px;
      position: fixed;
      z-index: var(--z-header);
      inset-inline: 0;
      bottom: calc(var(--tabbar-bottom) + env(safe-area-inset-bottom, 0px));
      width: fit-content;
      margin-inline: auto;
      display: flex;
      align-items: center;
      gap: var(--tab-gap);
      height: var(--tabbar-cap-h);
      padding: 3px 4px;
      border-radius: var(--radius-pill);
      /* Cristal: indigo translucido; sin backdrop-filter queda mas opaco para no perder lectura */
      background: color-mix(in srgb, var(--ink) 88%, transparent);
      border: 1px solid color-mix(in srgb, var(--text) 14%, transparent);
      /* brillo superior tenue + sombra suave */
      box-shadow:
        inset 0 1px 0 color-mix(in srgb, var(--text) 16%, transparent),
        0 10px 30px rgb(0 0 0 / 0.4);
    }
    @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
      .tabbar {
        background: color-mix(in srgb, var(--ink) 55%, transparent);
        -webkit-backdrop-filter: blur(18px) saturate(1.4);
        backdrop-filter: blur(18px) saturate(1.4);
      }
    }
  }

  /* Indicador: halo suave + punto, un solo elemento que se desliza (transform) hasta el icono activo */
  .tabbar__ind {
    position: absolute;
    top: 3px; /* contra el borde de relleno: igual al padding de la capsula (3px 4px) */
    left: 4px;
    width: var(--tab);
    height: var(--tab-h);
    pointer-events: none;
    opacity: 0;
    transform: translateX(calc(var(--i, 0) * (var(--tab) + var(--tab-gap))));
    transition:
      transform 0.3s var(--ease-out),
      opacity 0.25s var(--ease-out);
  }
  .tabbar__ind[data-on] {
    opacity: 1;
  }
  .tabbar__ind[data-snap] {
    transition: none;
  }
  .tabbar__ind::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 1.25rem;
    background: radial-gradient(ellipse 60% 55% at 50% 38%, color-mix(in srgb, var(--cyan) 24%, transparent), transparent 100%);
  }
  .tabbar__ind::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 3px;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 8px color-mix(in srgb, var(--cyan) 80%, transparent);
  }

  .tab {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 3px;
    padding-top: 7px;
    flex: 0 0 var(--tab);
    width: var(--tab);
    height: var(--tab-h);
    border-radius: 1.25rem;
    color: var(--text-2);
    -webkit-tap-highlight-color: transparent;
    transition: color 0.25s var(--ease-out);
  }
  .tab svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s var(--ease-out);
  }
  .tab__label {
    font-size: 10.5px;
    font-weight: var(--w-medium);
    letter-spacing: 0.04em;
    line-height: 1;
    color: color-mix(in srgb, var(--text) 60%, transparent);
    transition: color 0.25s var(--ease-out);
  }
  .tab[aria-current='page'] .tab__label {
    color: var(--cyan);
  }
  .tab[aria-current='page'] {
    color: var(--cyan);
  }
  .tab:active svg {
    transform: scale(0.88);
  }
  .tab:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: -2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .tabbar__ind,
    .tab,
    .tab svg {
      transition: none;
    }
  }
</style>

<script>
  type Tab = 'home' | 'trabajo' | 'contacto' | '';

  function tabFor(pathname: string): Tab {
    if (pathname === '/' || pathname === '') return 'home';
    if (pathname.startsWith('/trabajo')) return 'trabajo';
    if (pathname.startsWith('/contacto')) return 'contacto';
    return '';
  }

  /** Marca la pestana activa y desliza el indicador (legales / 404: sin activa, el indicador se apaga). */
  function sync(id: Tab, snap = false): void {
    const nav = document.querySelector<HTMLElement>('.tabbar');
    const ind = nav?.querySelector<HTMLElement>('.tabbar__ind');
    if (!nav || !ind) return;
    let idx = -1;
    for (const a of nav.querySelectorAll<HTMLAnchorElement>('[data-tab]')) {
      const on = a.dataset.tab === id;
      if (on) idx = Number(a.dataset.i);
      if (on !== a.hasAttribute('aria-current')) {
        if (on) a.setAttribute('aria-current', 'page');
        else a.removeAttribute('aria-current');
      }
    }
    if (snap) ind.setAttribute('data-snap', '');
    if (idx >= 0) {
      nav.style.setProperty('--i', String(idx));
      ind.style.setProperty('--i', String(idx));
      ind.setAttribute('data-on', '');
    } else {
      ind.removeAttribute('data-on');
    }
    if (snap) requestAnimationFrame(() => requestAnimationFrame(() => ind.removeAttribute('data-snap')));
  }

  sync(tabFor(location.pathname), true);
  // Respuesta inmediata al tocar: la pestana cambia al empezar el viaje, no al llegar.
  document.addEventListener('astro:before-preparation', (ev) => {
    const to = (ev as Event & { to?: URL }).to;
    if (to) sync(tabFor(to.pathname));
  });
  document.addEventListener('astro:page-load', () => sync(tabFor(location.pathname)));
</script>
