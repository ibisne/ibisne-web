---
/**
 * Barra inferior tipo app. Solo se ve en modo scroll (movil, o ventana menor a 1024x700);
 * en escritorio el header lleva la navegacion. Persiste entre paginas (ClientRouter) y su
 * script marca la pestana activa al navegar. Alto: --tabbar-h (64px + safe-area, global.css).
 */
import { WA_BASE } from './contact-data';
---

<nav class="tabbar" aria-label="Navegación móvil" transition:persist="tabbar">
  <a class="tab" href="/" data-tab="home">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M4 11.2 12 4l8 7.2V19a1.5 1.5 0 0 1-1.5 1.5H15v-5.2a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v5.2H5.5A1.5 1.5 0 0 1 4 19Z"></path>
    </svg>
    <span class="tab__label">Inicio</span>
  </a>

  <a class="tab" href="/trabajo/" data-tab="trabajo">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <rect x="4" y="4" width="6.5" height="6.5" rx="1.6"></rect>
      <rect x="13.5" y="4" width="6.5" height="6.5" rx="1.6"></rect>
      <rect x="4" y="13.5" width="6.5" height="6.5" rx="1.6"></rect>
      <rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.6"></rect>
    </svg>
    <span class="tab__label">Trabajo</span>
  </a>

  <a class="tab" href="/contacto/" data-tab="contacto">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <rect x="3.5" y="5.5" width="17" height="13" rx="2.2"></rect>
      <path d="m4.5 7.5 7.5 5.7 7.5-5.7"></path>
    </svg>
    <span class="tab__label">Contacto</span>
  </a>

  <a class="tab tab--cta" href={WA_BASE} target="_blank" rel="noopener" aria-label="Hablemos, abre WhatsApp en otra pestaña">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M5.5 4h13A1.5 1.5 0 0 1 20 5.5v9a1.5 1.5 0 0 1-1.5 1.5H11l-4.2 3.6a.5.5 0 0 1-.8-.4V16h-.5A1.5 1.5 0 0 1 4 14.5v-9A1.5 1.5 0 0 1 5.5 4Z"></path>
      <path d="M8.5 10.2h.01M12 10.2h.01M15.5 10.2h.01"></path>
    </svg>
    <span class="tab__label">Hablemos</span>
  </a>
</nav>

<style>
  .tabbar {
    display: none;
  }

  @media not ((min-width: 1024px) and (min-height: 700px)) {
    .tabbar {
      position: fixed;
      inset: auto 0 0 0;
      z-index: var(--z-header);
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      height: var(--tabbar-h);
      padding: 0 env(safe-area-inset-right, 0px) env(safe-area-inset-bottom, 0px) env(safe-area-inset-left, 0px);
      background: color-mix(in srgb, var(--ink) 80%, transparent);
      -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(1.3);
      backdrop-filter: blur(var(--glass-blur)) saturate(1.3);
      border-top: 1px solid var(--line);
    }
  }

  .tab {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    min-width: 0;
    color: var(--text-3);
    -webkit-tap-highlight-color: transparent;
    transition: color 0.25s var(--ease-out);
  }
  .tab svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      transform 0.3s var(--ease-out),
      color 0.25s var(--ease-out);
  }
  .tab__label {
    font-size: 11px;
    font-weight: var(--w-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
  }

  /* Indicador de la pestana activa: raya de luz arriba */
  .tab::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 50%;
    width: 28px;
    height: 2px;
    border-radius: 2px;
    background: var(--grad-accent);
    box-shadow: 0 0 12px color-mix(in srgb, var(--cyan) 70%, transparent);
    transform: translateX(-50%) scaleX(0);
    transition: transform 0.35s var(--ease-out);
  }
  .tab[aria-current='page'] {
    color: var(--text);
  }
  .tab[aria-current='page'] svg {
    color: var(--cyan);
    transform: translateY(-1px);
  }
  .tab[aria-current='page']::before {
    transform: translateX(-50%) scaleX(1);
  }

  /* Hablemos: accion, no destino. Icono magenta, nunca "activo" */
  .tab--cta svg {
    color: var(--magenta);
  }
  .tab--cta {
    color: var(--text-2);
  }

  .tab:active svg {
    transform: scale(0.88);
  }
  .tab:focus-visible {
    outline-offset: -6px;
    border-radius: 12px;
  }

  /* Horizontal en telefono: barra baja, icono mas chico */
  @media (max-height: 499px) {
    .tab {
      gap: 0.2rem;
    }
    .tab svg {
      width: 20px;
      height: 20px;
    }
  }
</style>

<script>
  type Tab = 'home' | 'trabajo' | 'contacto' | '';

  function tabFor(pathname: string): Tab {
    if (pathname === '/' || pathname === '') return 'home';
    if (pathname.startsWith('/trabajo')) return 'trabajo';
    if (pathname.startsWith('/contacto')) return 'contacto';
    return '';
  }

  function sync(id: Tab): void {
    for (const a of document.querySelectorAll<HTMLAnchorElement>('.tabbar [data-tab]')) {
      if (a.dataset.tab === id) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    }
  }

  sync(tabFor(location.pathname));
  // Respuesta inmediata al tocar: la pestana cambia al empezar el viaje, no al llegar.
  document.addEventListener('astro:before-preparation', (ev) => {
    const to = (ev as Event & { to?: URL }).to;
    if (to) sync(tabFor(to.pathname));
  });
  document.addEventListener('astro:page-load', () => sync(tabFor(location.pathname)));
</script>
