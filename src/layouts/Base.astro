---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import World from '../components/World.astro';
import Header from '../components/Header.astro';
import MobileTabBar from '../components/MobileTabBar.astro';
import Consent from '../components/Consent.astro';
import Cursor from '../components/Cursor.astro';
import LegalFooter from '../components/LegalFooter.astro';
import Entry from '../components/Entry.astro';

export type PageKind = 'home' | 'trabajo' | 'proyecto' | 'contacto' | 'legal' | '404';

interface Props {
  title: string;
  description?: string;
  /** Define data-page en <html>: gobierna el scroll de escritorio. La estacion del mundo sale de la URL (world/stationForPath) */
  page: PageKind;
  /** none | full. Por defecto: full en contacto/legal, none en el resto */
  legalFooter?: 'none' | 'full';
  /** Alias booleano: true = pie completo, false = sin pie */
  footerLegal?: boolean;
  /** Ruta absoluta (desde /) de la imagen OG; por defecto /og.jpg */
  image?: string;
  noindex?: boolean;
  /** Pasa true para no anteponer/sufijar la marca al titulo */
  rawTitle?: boolean;
}

const DEFAULT_DESC = 'Diseñamos tecnología para marcas selectas. Estudio de producto y software en Mérida, Yucatán y Zapopan, Jalisco.';
const { title, description = DEFAULT_DESC, page, image = '/og.jpg', noindex = false, rawTitle = false } = Astro.props;
const footerDefault = { home: 'none', trabajo: 'none', proyecto: 'none', contacto: 'full', legal: 'full', '404': 'none' } as const;
const aliasFooter = Astro.props.footerLegal === undefined ? undefined : Astro.props.footerLegal ? 'full' : 'none';
const legalFooter = Astro.props.legalFooter ?? aliasFooter ?? footerDefault[page];

const fullTitle = rawTitle || title.includes('iBisne') ? title : `${title} · iBisne`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'iBisne',
  legalName: 'iBisne S.A.S. de C.V.',
  url: 'https://www.ibisne.com/',
  logo: new URL('/icon-512.png', Astro.site).href,
  description: DEFAULT_DESC,
  address: { '@type': 'PostalAddress', streetAddress: 'Av. Campestre, C. 3A 11, entre 3 y, Campestre', postalCode: '97120', addressLocality: 'Mérida', addressRegion: 'Yucatán', addressCountry: 'MX' },
};
---

<!doctype html>
<html lang="es-MX" data-page={page} data-boot>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta name="theme-color" content="#0B0820" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="iBisne" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <ClientRouter />
    <noscript><style>html[data-boot] main#page { opacity: 1; } [data-entry] { display: none !important; }</style></noscript>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
    <script>
      import '../scripts/travel.ts';
      import '../scripts/text-glitch.ts';
    </script>
  </head>
  <body>
    <a class="skip-link" href="#page">Saltar al contenido</a>
    <World />
    <Header />
    <main id="page" tabindex="-1">
      <slot />
      {legalFooter !== 'none' && <LegalFooter />}
    </main>
    <MobileTabBar />
    <Consent />
    <Cursor />
    <Entry />
  </body>
</html>
