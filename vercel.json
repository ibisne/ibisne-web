{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://www.googletagmanager.com; img-src 'self' data: https:; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
      ]
    },
    {
      "source": "/design-system-v2/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/demos/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self' https:; style-src 'self' 'unsafe-inline' https:; font-src 'self' https: data:; script-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; media-src 'self' https:; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/webs.html",
      "destination": "/#pricing",
      "permanent": true
    },
    {
      "source": "/webs",
      "destination": "/#pricing",
      "permanent": true
    },
    { "source": "/servicios/sitios-web", "destination": "/servicios/comercio/", "permanent": true },
    { "source": "/servicios/ecommerce", "destination": "/servicios/comercio/", "permanent": true },
    { "source": "/servicios/apps", "destination": "/servicios/producto/", "permanent": true },
    { "source": "/servicios/crm", "destination": "/servicios/producto/", "permanent": true },
    { "source": "/servicios/erp", "destination": "/servicios/producto/", "permanent": true },
    { "source": "/servicios/saas", "destination": "/servicios/producto/", "permanent": true },
    { "source": "/servicios/ia", "destination": "/servicios/frontera/", "permanent": true },
    { "source": "/servicios/web3", "destination": "/servicios/frontera/", "permanent": true }
  ]
}
