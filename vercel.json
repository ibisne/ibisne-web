{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "trailingSlash": true,
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com; font-src 'self'; media-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "require-trusted-types-for 'script'; trusted-types ib-ga default"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/trabajo/ipools",
      "destination": "/trabajo/",
      "permanent": true
    },
    {
      "source": "/trabajo/ipools/",
      "destination": "/trabajo/",
      "permanent": true
    },
    {
      "source": "/trabajo/acefap",
      "destination": "/trabajo/",
      "permanent": true
    },
    {
      "source": "/trabajo/acefap/",
      "destination": "/trabajo/",
      "permanent": true
    },
    {
      "source": "/trabajo/cluster",
      "destination": "/trabajo/",
      "permanent": true
    },
    {
      "source": "/trabajo/cluster/",
      "destination": "/trabajo/",
      "permanent": true
    },
    {
      "source": "/trabajo/endomap",
      "destination": "/trabajo/",
      "permanent": true
    },
    {
      "source": "/trabajo/endomap/",
      "destination": "/trabajo/",
      "permanent": true
    },
    {
      "source": "/servicios",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/servicios/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/como-trabajamos",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/como-trabajamos/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/inversion",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/inversion/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/por-que-ibisne",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/por-que-ibisne/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/estudio",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/estudio/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/insights",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/insights/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/portafolio",
      "destination": "/trabajo/",
      "permanent": true
    },
    {
      "source": "/portafolio/(.*)",
      "destination": "/trabajo/",
      "permanent": true
    },
    {
      "source": "/promos",
      "destination": "/contacto/",
      "permanent": true
    },
    {
      "source": "/promos/(.*)",
      "destination": "/contacto/",
      "permanent": true
    },
    {
      "source": "/empecemos",
      "destination": "/contacto/",
      "permanent": true
    },
    {
      "source": "/empecemos/(.*)",
      "destination": "/contacto/",
      "permanent": true
    },
    {
      "source": "/legal/cancelacion",
      "destination": "/legal/terminos/",
      "permanent": true
    },
    {
      "source": "/legal/cancelacion/(.*)",
      "destination": "/legal/terminos/",
      "permanent": true
    },
    {
      "source": "/webs",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/webs/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/webs.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/contacto/index.html",
      "destination": "/contacto/",
      "permanent": true
    },
    {
      "source": "/assets/og-default.png",
      "destination": "/og.jpg",
      "permanent": true
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "permanent": true
    },
    {
      "source": "/trabajo/iwellscore",
      "destination": "/trabajo/",
      "permanent": true
    },
    {
      "source": "/trabajo/iwellscore/",
      "destination": "/trabajo/",
      "permanent": true
    }
  ]
}
